# Cross-compiles the Windows build (MinGW-w64, Qt 5) on Linux:
#   packaging/build-windows-cross.sh
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
        mingw64-gcc-c++ mingw64-qt5-qtbase mingw64-qt5-qttools mingw64-openal-soft \
        mingw64-pkg-config mingw64-winpthreads mingw32-nsis zip findutils file \
    && dnf clean all
